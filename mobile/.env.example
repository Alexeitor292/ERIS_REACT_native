# ============================================================
# ERIS Mobile — Expo environment variables
# Copy to: mobile/.env
# Restart Expo (npx expo start --clear) after editing.
# ============================================================

# API server URL
# Optional for local dev: when unset, the app derives the host from the
# Metro bundler address (physical device), Android emulator alias, or localhost.
# Required for Proxmox / server testing — set to the backend's public URL.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000   # local network IP
#   EXPO_PUBLIC_API_URL=http://YOUR_PROXMOX_IP:8000
#
# EXPO_PUBLIC_API_URL=

# ArcGIS offline map package
# Leave blank unless you have a licensed MMPK file deployed.
# EXPO_PUBLIC_ARCGIS_MMPK_PATH=
# EXPO_PUBLIC_ARCGIS_MMPK_URL=
