# Copy to bootstrap.env only for the first installation; chmod 600. Delete it
# after the first successful start.
# The first administrator signs in through Entra: IT supplies their Entra user
# object ID (Entra admin center > Users > the person > Object ID).
ERIS_BOOTSTRAP_ADMIN_EMAIL=first.admin@dot.ca.gov
ERIS_BOOTSTRAP_ADMIN_NAME=First Administrator
ERIS_BOOTSTRAP_ADMIN_ENTRA_OBJECT_ID=00000000-0000-0000-0000-000000000000
# Rehearsals without Entra only (LOCAL_LOGIN_ENABLED=true): a temporary password
# instead of the object ID. Refused when LOCAL_LOGIN_ENABLED=false.
# ERIS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
