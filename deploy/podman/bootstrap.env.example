# Copy to bootstrap.env only for the first installation; chmod 600.
ERIS_BOOTSTRAP_ADMIN_EMAIL=first.admin@dot.ca.gov
ERIS_BOOTSTRAP_ADMIN_NAME=First Administrator
ERIS_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
