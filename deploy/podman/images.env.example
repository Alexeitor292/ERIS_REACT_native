# Copy to images.env. Mirror every image into the approved Harbor project.
# Production: use the approved @sha256 digests (Jenkins archives the three ERIS
# digests as release-images.env) and set ERIS_REQUIRE_DIGESTS=true so a tag can
# never be deployed by mistake.
ERIS_API_IMAGE=harbor.example.gov/eris/api:RELEASE
ERIS_WORKER_IMAGE=harbor.example.gov/eris/worker:RELEASE
ERIS_WEB_IMAGE=harbor.example.gov/eris/web:RELEASE
ERIS_DB_IMAGE=harbor.example.gov/eris/mariadb:11
ERIS_STORAGE_IMAGE=harbor.example.gov/eris/seaweedfs:4.50
ERIS_REQUIRE_DIGESTS=false
