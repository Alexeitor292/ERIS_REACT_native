# Copy to app.env; chmod 600. This is read only by API, worker and one-shot tools.
ENV=prod
API_DOCS_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eris
DB_USER=eris_user
DB_PASS=CHANGE_ME
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=https://eris-files.example.gov
S3_BUCKET=eris-uploads
S3_OFFLINE_SCENES_BUCKET=eris-offline-scenes
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
STORAGE_URL_MODE=presigned
OFFLINE_SCENE_DEV_MODE=false
# Server signing key (Entra state, CSRF tokens): openssl rand -hex 32.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
# Server-side sessions: reauthenticate after 30 idle minutes and 12 hours in
# total (NIST SP 800-63B AAL2). ENV=prod refuses anything over 720.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=720
# Sign-in requests per client address per minute (429 beyond it); 0 = off.
AUTH_RATE_LIMIT_PER_MINUTE=30
# Proxies that append to X-Forwarded-For: the Caltrans TLS gateway + the pod's
# nginx = 2. Use 1 if the gateway does not send X-Forwarded-For (then every
# client shares one limit: raise AUTH_RATE_LIMIT_PER_MINUTE accordingly).
TRUSTED_PROXY_HOPS=2
WEB_BASE_URL=https://eris.example.gov
CORS_ORIGINS=https://eris.example.gov
# Caltrans signs in through Entra only: no ERIS passwords exist to be phished,
# reused or reset, and Entra applies MFA and Conditional Access to every sign-in.
LOCAL_LOGIN_ENABLED=false
ENTRA_ENABLED=true
ENTRA_AUTHORITY_HOST=login.microsoftonline.com
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_REDIRECT_URI=https://eris.example.gov/api/auth/entra/callback
# Certificate credential, not a client secret: put the PEM certificate and its
# private key in deploy/podman/secrets/ (chmod 700 dir, 600 files). eris-pod.sh
# mounts that folder read-only into the API container only. Upload the
# certificate (never the key) to the app registration.
ENTRA_CLIENT_CERT_FILE=/run/secrets/eris/entra-client.crt
ENTRA_CLIENT_KEY_FILE=/run/secrets/eris/entra-client.key
# Mobile app (optional): its separate public client ID, and the ERIS API scope
# the web app registration exposes. Leave the client ID empty to keep mobile off.
ENTRA_MOBILE_CLIENT_ID=
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Push to the native iOS app through APNs (token auth). Put the .p8 auth key from
# the Caltrans Apple developer account in deploy/podman/secrets/.
APNS_ENABLED=false
APNS_KEY_FILE=/run/secrets/eris/apns-auth-key.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=gov.ca.dot.eris
