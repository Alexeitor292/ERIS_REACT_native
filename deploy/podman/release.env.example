# Copy to release.env (no secrets) to let `eris-pod.sh release` run unattended.
# Where pre-release backups go: a private, access-controlled path with room for
# a full DB + object copy per release. Move copies off-host per backup policy.
ERIS_BACKUP_ROOT=/secure/eris-backups
# Public names the post-release verification checks through the TLS gateway.
# Production releases require BOTH HTTPS origins and never skip public checks.
# An isolated packaging rehearsal may explicitly set ERIS_VERIFY_PROFILE=rehearsal
# and leave these empty; it does not establish production acceptance.
ERIS_PUBLIC_URL=https://eris.example.gov
ERIS_FILES_URL=https://eris-files.example.gov
ERIS_VERIFY_PROFILE=production
