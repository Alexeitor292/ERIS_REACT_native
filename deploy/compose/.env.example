# ============================================================
# DOCKER / INFRASTRUCTURE SECTION
# ============================================================
# These variables are consumed by docker-compose.yml.
# They DEFINE (create) credentials inside the MariaDB and SeaweedFS containers.
# You are creating the usernames and passwords here.

TZ=America/Los_Angeles

# MariaDB bootstrap
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
MARIADB_DATABASE=eris
MARIADB_USER=eris_user
MARIADB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# SeaweedFS bootstrap
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
