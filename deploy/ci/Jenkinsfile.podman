// Jenkins agent needs Linux, Podman and access to the approved Harbor registry.
// Supply chain: every one of the five images is scanned (SBOM + vulnerability and
// secret gate), signed by digest with the Caltrans cosign key, and its SBOM is
// attached as a signed attestation. A failed gate stops the release before push.
pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  parameters {
    string(name: 'HARBOR_HOST', defaultValue: 'harbor.example.gov', description: 'Approved Harbor hostname')
    string(name: 'HARBOR_PROJECT', defaultValue: 'eris', description: 'Harbor project')
    string(name: 'RELEASE_TAG', defaultValue: '', description: 'Immutable release tag; blank uses the Jenkins build number')
    string(name: 'MARIADB_SOURCE', defaultValue: '', description: 'Optional approved MariaDB mirror; blank builds the patched repository recipe')
    string(name: 'SEAWEEDFS_SOURCE', defaultValue: '', description: 'Optional approved SeaweedFS mirror; blank builds the patched repository recipe')
    string(name: 'TRIVY_IMAGE', defaultValue: 'docker.io/aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb', description: 'Scanner image; mirror into Harbor and pin by digest')
    string(name: 'COSIGN_IMAGE', defaultValue: '', description: 'Blank builds the patched repository signing tool; optional approved mirror is audited before use')
    string(name: 'COSIGN_REGISTRY_CA_FILE', defaultValue: '', description: 'Optional PEM registry CA file on the Jenkins agent, mounted read-only in the signer; host Podman also needs agency CA trust')
    string(name: 'TRIVY_DB_REPOSITORY', defaultValue: '', description: 'Harbor mirror of the Trivy vulnerability database (blank: Trivy default)')
    string(name: 'TRIVY_SEVERITY', defaultValue: 'UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL', description: 'Severities that fail the gate, including findings without a fix; changes require security approval')
    choice(name: 'DEPLOY_TO', choices: ['none', 'staging', 'staging-then-production'], description: 'After publishing: release to staging, then (after approval) the same digests to production')
    string(name: 'STAGING_HOST', defaultValue: '', description: 'ERIS staging host (SSH, service account with deploy-hook.sh forced command)')
    string(name: 'PRODUCTION_HOST', defaultValue: '', description: 'ERIS production host')
    string(name: 'PRODUCTION_APPROVERS', defaultValue: 'eris-release-approvers', description: 'Jenkins users/groups allowed to approve a production release')
    booleanParam(name: 'ENTRA_ENABLED', defaultValue: true, description: 'Fallback only: the web asks the API (/api/auth/config) which sign-in methods are on')
    booleanParam(name: 'LOCAL_LOGIN_ENABLED', defaultValue: false, description: 'Fallback only: the web asks the API (/api/auth/config) which sign-in methods are on')
  }
  environment {
    TRIVY_CACHE_DIR = "${WORKSPACE}/.cache/trivy"
    RELEASE_DIR = "${WORKSPACE}/release"
  }
  stages {
    stage('Validate') {
      steps {
        sh 'test -f backend/Dockerfile && test -f web/Dockerfile && test -f deploy/podman/eris-pod.sh'
        sh 'for script in deploy/podman/*.sh deploy/podman/tests/*.sh deploy/ci/*.sh deploy/ci/tests/*.sh; do bash -n "$script"; done'
        // Deployment and release-gate scripts against stub podman/curl.
        sh '''
          set -eu
          bash deploy/podman/tests/test-eris-pod.sh
          bash deploy/podman/tests/test-verify-rehearsal.sh
          bash deploy/ci/tests/test-release-gate.sh
          bash deploy/ci/tests/test-publish-release.sh
        '''
      }
    }
    stage('Build') {
      steps {
        script {
          env.ERIS_TAG = params.RELEASE_TAG.trim() ?: "build-${env.BUILD_NUMBER}"
          if (!(env.ERIS_TAG ==~ /[A-Za-z0-9_.-]+/)) error('Invalid release tag')
          env.ERIS_REPO = "${params.HARBOR_HOST}/${params.HARBOR_PROJECT}"
          env.ERIS_SOURCE_REVISION = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
          env.BUILD_COSIGN_FROM_SOURCE = params.COSIGN_IMAGE.trim() ? 'false' : 'true'
          env.COSIGN_IMAGE = params.COSIGN_IMAGE.trim() ?: "${env.ERIS_REPO}/cosign-tool:${env.ERIS_TAG}"
        }
        // The website's browser-safe ArcGIS key, restricted to its address (docs/operations/map-licensing.md).
        withCredentials([string(credentialsId: 'eris-arcgis-web-key', variable: 'VITE_ARCGIS_API_KEY')]) {
          sh '''
            set -eu
            test -n "$VITE_ARCGIS_API_KEY" || { echo 'Set the agency-owned, origin-restricted web ArcGIS key'; exit 2; }
            labels="--label org.opencontainers.image.revision=$ERIS_SOURCE_REVISION --label org.opencontainers.image.version=$ERIS_TAG"
            if [ "$BUILD_COSIGN_FROM_SOURCE" = true ]; then
              podman build --pull=always --no-cache $labels -f deploy/images/Dockerfile.cosign -t "$COSIGN_IMAGE" .
            fi
            podman build --pull=always --no-cache $labels -t "$ERIS_REPO/api:$ERIS_TAG" backend
            podman build --pull=always --no-cache $labels -f backend/Dockerfile.worker -t "$ERIS_REPO/worker:$ERIS_TAG" backend
            bash deploy/podman/build-web.sh "$ERIS_REPO/web:$ERIS_TAG" \
              "$ENTRA_ENABLED" "$LOCAL_LOGIN_ENABLED"
            podman run --rm --entrypoint python "$ERIS_REPO/api:$ERIS_TAG" -X pycache_prefix=/tmp/eris-pycache -m compileall -q app
            if [ -z "$MARIADB_SOURCE" ]; then
              podman build --pull=always --no-cache $labels -f deploy/images/Dockerfile.mariadb -t "$ERIS_REPO/mariadb:$ERIS_TAG" .
            fi
            if [ -z "$SEAWEEDFS_SOURCE" ]; then
              podman build --pull=always --no-cache $labels -f deploy/images/Dockerfile.seaweedfs -t "$ERIS_REPO/seaweedfs:$ERIS_TAG" .
            fi
          '''
        }
      }
    }
    stage('Backend security checks') {
      steps {
        sh '''
          set -eu
          podman run --rm --network none \
            -e DB_PASS=ci_placeholder -e JWT_SECRET=ci_placeholder_secret \
            -e S3_ACCESS_KEY=ci_s3_access -e S3_SECRET_KEY=ci_s3_secret \
            -v "$WORKSPACE/backend/tests:/app/tests:ro,Z" \
            "$ERIS_REPO/api:$ERIS_TAG" \
            python -m pytest tests/test_entra_oidc.py tests/test_route_guards.py \
              tests/test_session_security.py tests/test_admin_handover.py \
              tests/test_entra_certificate_and_mobile.py tests/test_apns_push.py tests/test_rate_limit.py \
              tests/test_photo_upload_limits.py tests/test_notification_smtp.py tests/test_sql_parameterization.py -q
        '''
      }
    }
    stage('Scan all images, publish, sign and attest') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'harbor-eris-robot', usernameVariable: 'HARBOR_USER', passwordVariable: 'HARBOR_PASS'),
          file(credentialsId: 'eris-cosign-key', variable: 'COSIGN_KEY_FILE'),
          string(credentialsId: 'eris-cosign-password', variable: 'COSIGN_PASSWORD')
        ]) {
          sh '''
            set -eu
            auth_dir="$(mktemp -d)"
            export REGISTRY_AUTH_FILE="$auth_dir/auth.json"
            trap 'podman logout --authfile "$REGISTRY_AUTH_FILE" "$HARBOR_HOST" >/dev/null 2>&1 || true; rm -rf -- "$auth_dir"' EXIT
            printf '%s' "$HARBOR_PASS" | podman login --authfile "$REGISTRY_AUTH_FILE" "$HARBOR_HOST" \
              --username "$HARBOR_USER" --password-stdin
            # Audit the configured signer before it receives a signing key.
            if [ "$BUILD_COSIGN_FROM_SOURCE" != true ]; then
              podman pull --authfile "$REGISTRY_AUTH_FILE" "$COSIGN_IMAGE"
            fi
            # Optional agency mirrors receive local destination tags before scanning.
            # They are never trusted solely because they already exist in Harbor.
            for name in mariadb seaweedfs; do
              if [ "$name" = mariadb ]; then source="$MARIADB_SOURCE"; else source="$SEAWEEDFS_SOURCE"; fi
              if [ -n "$source" ]; then
                podman pull --authfile "$REGISTRY_AUTH_FILE" "$source"
                podman tag "$source" "$ERIS_REPO/$name:$ERIS_TAG"
              fi
            done
            rm -rf -- "$RELEASE_DIR"
            bash deploy/ci/publish-release.sh "$ERIS_REPO" "$ERIS_TAG" "$RELEASE_DIR"
          '''
        }
      }
    }
    stage('Deploy to staging') {
      when { expression { params.DEPLOY_TO != 'none' } }
      steps {
        deployRelease('staging', params.STAGING_HOST)
      }
    }
    stage('Deploy to production') {
      when { expression { params.DEPLOY_TO == 'staging-then-production' } }
      steps {
        // The digests just proven in staging, after a named approval; record the
        // change ticket in the approval comment.
        input message: "Release ERIS ${env.ERIS_TAG} (verified in staging) to production?",
              ok: 'Release to production', submitter: params.PRODUCTION_APPROVERS
        deployRelease('production', params.PRODUCTION_HOST)
      }
    }
  }
  post {
    always {
      // SBOMs and scan reports are evidence even when the gate fails.
      archiveArtifacts artifacts: 'release/**', allowEmptyArchive: true, fingerprint: true
    }
    success { echo "Published ERIS ${env.ERIS_TAG}: release/release-images.env, release/sbom/, release/cosign.pub. Follow docs/operations/caltrans-podman.md to approve and deploy." }
  }
}

// Sends release-images.env to the host's deploy-hook.sh (an SSH forced command:
// the key can do nothing else). The host pulls under its signature policy, backs
// up, migrates, verifies in production mode, and rolls back by itself on failure;
// a nonzero exit here means the release did not go live.
def deployRelease(String target, String host) {
  if (!(host ==~ /[A-Za-z0-9.-]+/)) { error("Set a valid ${target} host") }
  withCredentials([
    sshUserPrivateKey(credentialsId: "eris-deploy-${target}", keyFileVariable: 'DEPLOY_KEY', usernameVariable: 'DEPLOY_USER'),
    file(credentialsId: 'eris-known-hosts', variable: 'KNOWN_HOSTS')
  ]) {
    withEnv(["DEPLOY_HOST=${host}"]) {
      sh '''
        set -eu
        ssh -i "$DEPLOY_KEY" -o IdentitiesOnly=yes -o BatchMode=yes           -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$KNOWN_HOSTS"           "$DEPLOY_USER@$DEPLOY_HOST" < "$RELEASE_DIR/release-images.env"
      '''
    }
  }
}
