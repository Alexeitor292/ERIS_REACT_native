# ============================================================
# ERIS WebUI — Vite environment variables
# Copy to: web/.env   (or web/.env.production for prod builds)
# ============================================================
#
# IMPORTANT: Vite only exposes variables prefixed with VITE_ to the browser, and
# it INLINES them at BUILD TIME (`npm run build`). They are NOT secret — anything
# here ships in the JS bundle. Never put a server-only secret in this file.

# Backend API base URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional "Caltrans Highways & Freeways" ONLINE map layer (PUBLIC, credential-free
# Caltrans CRS Functional Classification FeatureServer). Streamed live and shown as an
# opt-in toggle in the map's Layers widget (off by default), filtered to highway/freeway
# functional classes. This is a LIVE overlay and is completely independent of whether a
# downloaded offline package contains packaged roads. Leave blank to hide the toggle.
# Only a public, credential-free URL belongs here (VITE_* is public + build-time inlined).
VITE_CALTRANS_HIGHWAYS_URL=https://caltrans-gis.dot.ca.gov/arcgis/rest/services/CHhighway/CRS_Functional_Classification/FeatureServer/0

# ArcGIS Maps SDK API key — powers the interactive 3D terrain SceneView
# (Esri World Imagery + World Elevation). OPTIONAL for local dev (Esri default
# services work without a key), REQUIRED for production quota/licensing.
#
#  * This must be a BROWSER-SAFE ArcGIS API key (it is public in the bundle).
#  * Restrict it in the ArcGIS Developer dashboard to the ERIS WebUI origin
#    (HTTP referrer allow-list), e.g. https://eris.camposlabs.org — so a leaked
#    key cannot be used from other sites.
#  * Scope it to only the basemap/elevation services it needs.
#  * This is NOT the backend ARCGIS_API_KEY. The server key (issued via
#    /arcgis/runtime-config for the mobile native runtime) must NEVER be placed
#    here or exposed to the frontend.
#
# VITE_ARCGIS_API_KEY=your-browser-safe-domain-restricted-arcgis-key

# ---- Docker build-time wiring (ERIS server) ----------------------------------
# Because Vite inlines VITE_* during the build, the key must be present when the
# web image is BUILT, not at container runtime. The web Dockerfile already has:
#
#   ARG VITE_ARCGIS_API_KEY=""
#   ENV VITE_ARCGIS_API_KEY=$VITE_ARCGIS_API_KEY
#   RUN ... npm run build
#
# and docker/docker-compose.proxmox.yml maps it into web.build.args:
#
#   services:
#     web:
#       build:
#         args:
#           VITE_ARCGIS_API_KEY: ${VITE_ARCGIS_API_KEY:-}
#
# DEPLOYMENT PATTERN — SHELL-ONLY build variable (do NOT put it in
# docker/.env.proxmox). The backend service loads .env.proxmox via `env_file:`,
# so any key placed there would also leak into the backend container's
# environment. Supplying it only as a shell variable keeps Compose substitution
# working for the web build arg while the backend env_file stays limited to
# .env.proxmox:
#
#   export VITE_ARCGIS_API_KEY='your-browser-safe-restricted-key'
#
#   docker compose --env-file .env.proxmox \
#     -f docker-compose.yml \
#     -f docker-compose.proxmox.yml \
#     up -d --build web
#
#   unset VITE_ARCGIS_API_KEY
#
# (Or pass it inline for the single command / from a CI secret store.) Rebuild the
# web image whenever the key changes — runtime env changes do nothing once baked.
