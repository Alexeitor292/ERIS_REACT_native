# Rasterio has no musllinux wheel: build its pinned source against GDAL in
# a disposable compiler stage, then retain only runtime GDAL and Python wheels.
# Keep apk and Python package metadata intact for vulnerability/SBOM scans.
FROM python:3.12-alpine@sha256:c5ba3deef00c7758561a0f03c26f44f10589263d40e732b8748e0d1f38f6dd89 AS wheels
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /build
ENV GDAL_CONFIG=/usr/bin/gdal-config
ARG GDAL_PACKAGE_VERSION=3.13.3-r0
RUN apk upgrade --no-cache && apk add --no-cache build-base "gdal-dev=${GDAL_PACKAGE_VERSION}"
COPY requirements.txt requirements-worker.txt constraints.txt ./
RUN pip install --no-cache-dir --upgrade pip==26.3 setuptools==84.2.1 && pip wheel --no-cache-dir --no-binary=rasterio --wheel-dir /wheels -r requirements-worker.txt
FROM python:3.12-alpine@sha256:c5ba3deef00c7758561a0f03c26f44f10589263d40e732b8748e0d1f38f6dd89
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
ENV GDAL_DATA=/usr/share/gdal PROJ_DATA=/usr/share/proj
ARG GDAL_PACKAGE_VERSION=3.13.3-r0
RUN apk upgrade --no-cache && apk add --no-cache "gdal=${GDAL_PACKAGE_VERSION}"
COPY --from=wheels /wheels /wheels
COPY requirements.txt requirements-worker.txt constraints.txt ./
RUN pip install --no-cache-dir --upgrade pip==26.3 setuptools==84.2.1 && pip install --no-cache-dir --no-index --find-links=/wheels -r requirements-worker.txt && rm -rf /wheels
COPY app ./app
COPY alembic.ini .
COPY migrations ./migrations
RUN addgroup -g 10001 eris && adduser -D -H -u 10001 -G eris eris
USER 10001:10001
CMD ["python", "-m", "app.worker.offline_scene_worker"]
