# Runtime
ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================================
# BACKEND APPLICATION SECTION
# ============================================================
# These variables are consumed by FastAPI.
# They DO NOT create users — they tell the backend how to connect.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eris
DB_USER=eris_user
DB_PASS=CHANGE_ME_APP_DB_PASSWORD

# MinIO (backend connects with these)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=eris-uploads
MINIO_SECURE=false


# ----------------------------
# JWT Authentication
# ----------------------------
# CRITICAL SECRET
# This signs all authentication tokens.
# If this leaks, attackers can forge login tokens.
# Generate with: openssl rand -base64 64

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=120
