# Runtime
ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Interactive Swagger/ReDoc/OpenAPI exposure. Local development keeps this on;
# production deployment examples explicitly disable it.
API_DOCS_ENABLED=true


# ============================================================
# BACKEND APPLICATION SECTION
# ============================================================
# These variables are consumed by FastAPI.
# They DO NOT create users — they tell the backend how to connect.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eris
DB_USER=eris_user
DB_PASS=CHANGE_ME_APP_DB_PASSWORD

# MinIO (backend connects with these)
# Use the same credentials you set in docker/.env for MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
# MINIO_ENDPOINT: host:port of the MinIO API (no scheme); the backend infers http vs https
#   from the presence of "https://" in the value. For local Docker: 127.0.0.1:9800
MINIO_ENDPOINT=127.0.0.1:9800
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=eris-uploads

# Storage URL mode:
#   presigned (default) — backend returns MinIO presigned GET URLs. Safe for any deployment.
#   public              — backend returns direct URLs (MINIO_PUBLIC_ENDPOINT/bucket/key).
#                         Use for internal-network alpha deployments where clients can reach
#                         MinIO directly. Requires MINIO_PUBLIC_ENDPOINT to be set.
STORAGE_URL_MODE=presigned

# Client-reachable MinIO API URL. Used in both modes:
#   - presigned: rewrites the presigned URL host/port so clients can reach MinIO.
#   - public:    base for direct object URLs (REQUIRED when STORAGE_URL_MODE=public).
# Example (local Docker): MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9800
# Example (Proxmox):      MINIO_PUBLIC_ENDPOINT=http://<ERIS_SERVER_IP>:9800
# MINIO_PUBLIC_ENDPOINT=


# ----------------------------
# JWT Authentication
# ----------------------------
# CRITICAL SECRET
# This signs all authentication tokens.
# If this leaks, attackers can forge login tokens.
# Generate with: openssl rand -base64 64

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=120


# ----------------------------
# Outbound email (notification outbox)
# ----------------------------
# Used by the approval notice: when a GeoTech assessment is approved the district
# coordinator is notified in-app AND by email. The EMAIL row is written into
# incident_notifications inside the approval transaction; delivery happens after
# commit, is retried by a sweeper, and is surfaced when it fails through
# GET /admin/notifications/undelivered.
#
# EMAIL IS DISABLED WHENEVER SMTP_HOST IS UNSET. That is the default here and in
# CI: the EMAIL row is still written (the audit record that a notice was due) and
# simply left undelivered. Nothing is sent and nothing raises.
#
# Do not set SMTP_HOST in production until two things are known: that users.email
# is a deliverable mailbox (it is the ERIS login), and the relay's host, port,
# whether it authenticates, and which From domain it accepts. Mail to a login
# that is not a mailbox bounces silently.

# Relay host. Leave unset (commented out) to keep email disabled.
# SMTP_HOST=smtp.example.dot.ca.gov
SMTP_PORT=587

# SMTP AUTH. Omit both for an unauthenticated internal relay.
# SMTP_PASSWORD has no default and is never logged.
# SMTP_USER=
# SMTP_PASSWORD=

# Envelope + header From, and the display name.
SMTP_FROM=eris-no-reply@dot.ca.gov
SMTP_FROM_NAME=ERIS

# Transport security. STARTTLS upgrades a plaintext connection after EHLO;
# SMTP_SSL opens an implicit-TLS socket (port 465). They are MUTUALLY EXCLUSIVE
# and the backend refuses to start if both are true — for 465 set
# SMTP_STARTTLS=false and SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false

# Socket timeout in seconds, so a dead relay cannot hold a background task open.
SMTP_TIMEOUT_S=10

# Bounds on ONE after-commit flush: at most this many messages and this many
# wall-clock seconds. Whatever is left stays in the outbox for the sweeper.
SMTP_MAX_RECIPIENTS_PER_FLUSH=25
SMTP_FLUSH_BUDGET_S=30

# Attempts before a row is a permanent failure listed by
# GET /admin/notifications/undelivered. Retries back off from last_attempt_at.
SMTP_MAX_ATTEMPTS=5

# The sweeper ignores rows older than this, so enabling SMTP months after the
# fact cannot flood inboxes with history.
SMTP_BACKLOG_MAX_AGE_HOURS=24

# Development/CI only: with SMTP_HOST unset, write each message as an .eml file
# into this directory instead of sending it. Makes the send path testable
# without a mail server. Leave unset in production.
# MAIL_DEV_DUMP_DIR=./var/mail

# Base URL used to build the deep link inside the message body.
WEB_BASE_URL=http://localhost:5173
