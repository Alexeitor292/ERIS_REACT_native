# -----------------------------
# Proxmox deployment env file
# Copy to: docker/.env.proxmox
# -----------------------------

TZ=America/Los_Angeles

# Container mode
ENV=prod
LOG_LEVEL=INFO

# MariaDB bootstrap credentials
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
MARIADB_DATABASE=eris
MARIADB_USER=eris_user
MARIADB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# MinIO bootstrap credentials
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=eris-uploads

# External endpoints
# Web app bakes this value into static assets during build.
VITE_API_BASE_URL=http://YOUR_PROXMOX_IP:8000
# Backward-compatible alias used by older bundles
VITE_API_BASE=http://YOUR_PROXMOX_IP:8000

# NOTE: VITE_ARCGIS_API_KEY (the browser-safe ArcGIS key for the 3D terrain
# SceneView) is intentionally NOT placed in this file. The backend service loads
# this whole file via `env_file:`, so anything here also lands in the backend
# container's environment. To keep that build-time-only browser key OUT of the
# backend, supply it as a SHELL variable at build time instead (Compose still
# substitutes it into web.build.args). See web/.env.example for the exact
# `export VITE_ARCGIS_API_KEY=... && docker compose ... up -d --build web` flow.

# Backend CORS origins
CORS_ORIGINS=http://YOUR_PROXMOX_IP:5173

# Storage URL mode:
#   presigned (default) — safe for any deployment; returns expiring presigned URLs.
#   public              — for internal-network alpha; returns direct MinIO URLs.
#                         Requires MINIO_PUBLIC_ENDPOINT and client network access to MinIO.
STORAGE_URL_MODE=public

# Client-reachable MinIO API URL.
# For alpha/Proxmox: set to the server IP and MinIO API port (default 9800).
# Web browsers and mobile clients must be able to reach this address directly.
# If MinIO CORS is needed for browser direct GET, allow the web origin in MinIO settings.
MINIO_PUBLIC_ENDPOINT=http://YOUR_PROXMOX_IP:9800

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=120

# Offline 3D scene packages (private bucket + automatic USGS-3DEP generation).
# Bucket is created/verified by the one-shot minio-init service; keep it PRIVATE.
MINIO_OFFLINE_SCENES_BUCKET=eris-offline-scenes
# Production posture: dev mode OFF. When false, MinIO offline-bucket posture
# problems fail closed instead of warning. Only set true for local iteration.
OFFLINE_SCENE_DEV_MODE=false
# One authoritative AOI ceiling (metres), enforced at the API, job creation, and
# the worker. Capped by an absolute hard ceiling so it is never statewide.
OFFLINE_SCENE_MAX_RADIUS_M=3000
# Max registered/downloadable package size (MB) — policy, not device memory.
OFFLINE_SCENE_MAX_PACKAGE_MB=512

# --- Offline road context (worker-only fetch; mobile never contacts a road source) ---
# Road SNAP/orientation context packaged into roads.geojson. See
# docs/adr-offline-road-context-source.md.
#   none                 = package NO road context (roads intentionally unavailable).
#   eris_internal        = zero-network; only works when the build context already has
#                          line geometry or a resolved road bearing.
#   census_tigerweb      = public U.S. Census TIGERweb Transportation roads (NO API key,
#                          NO token). Development road-snap context — NOT Caltrans,
#                          NOT engineering/survey grade.
#   arcgis_feature_service = generic AUTHORIZED ArcGIS/Enterprise centerline layer
#                          (set OFFLINE_SCENE_ROAD_SOURCE_URL). No token belongs in git.
#   caltrans_crs         = OPTIONAL Caltrans freeway/expressway road CONTEXT from the
#                          PUBLIC Caltrans CRS Functional Classification FeatureServer
#                          (NO token). Functional classification, NOT ownership — it does
#                          not prove a feature is Caltrans-owned or a State Route. See the
#                          caltrans block below.
OFFLINE_SCENE_ROADS_ENABLED=true
OFFLINE_SCENE_ROAD_SOURCE=census_tigerweb
OFFLINE_SCENE_ROAD_SOURCE_URL=
OFFLINE_SCENE_ROAD_BUFFER_M=250
OFFLINE_SCENE_ROAD_FETCH_TIMEOUT_S=30
OFFLINE_SCENE_ROAD_CROSS_SECTION_ENABLED=true
# Roads REQUIRED vs optional (applies to the selected provider, never to `none`). true =
# a road retrieval/validation/filter/packaging failure FAILS the job (no READY package
# without verified road data). false (default) = degrade to an unavailable roads layer.
OFFLINE_SCENE_ROADS_REQUIRED=false
# EXPLICIT, AUDITED fallback source. Empty = NO fallback (never a silent provider switch).
# Set to another real source (eris_internal | census_tigerweb | arcgis_feature_service) to
# fall back when the primary provider fails; the fallback is recorded in the manifest+logs.
OFFLINE_SCENE_ROAD_FALLBACK_SOURCE=
# TIGERweb layers: 2 = Primary Roads, 6 = Secondary Roads, 8 = Local Roads.
OFFLINE_SCENE_TIGERWEB_BASE_URL=https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/Transportation/MapServer
OFFLINE_SCENE_TIGERWEB_LAYERS=2,6,8
# Caltrans CRS Functional Classification (used ONLY when OFFLINE_SCENE_ROAD_SOURCE=caltrans_crs).
# PUBLIC, credential-free. F_System functional classes to include. DEFAULT 1,2 =
# 1 Interstate + 2 Other Freeways and Expressways (conservative freeway/expressway scope).
# Class 3 = "Principal Arterial - Other" is a SURFACE arterial, NOT a freeway; opt in with
# "1,2,3" only when broader principal-arterial context is wanted.
OFFLINE_SCENE_CALTRANS_ROADS_URL=https://caltrans-gis.dot.ca.gov/arcgis/rest/services/CHhighway/CRS_Functional_Classification/FeatureServer/0
OFFLINE_SCENE_CALTRANS_FUNCTIONAL_CLASSES=1,2
OFFLINE_SCENE_CALTRANS_PAGE_SIZE=1000
OFFLINE_SCENE_CALTRANS_MAX_FEATURES=20000
OFFLINE_SCENE_CALTRANS_MAX_PAGES=100
OFFLINE_SCENE_CALTRANS_MAX_RESPONSE_MB=32
OFFLINE_SCENE_CALTRANS_RETRIES=2

# --- Divided-highway corridor pairing (worker-side, deterministic, ADDITIVE) -----------
# TIGERweb packages a divided highway as TWO primary centerlines. This pass decides —
# LOCALLY ALONG THE ROUTE, never globally by route name or mere proximity — where two
# primary carriageways share one corridor, and derives a midpoint centerline so the map can
# show ONE selectable line. Legacy packages/clients are unaffected; a pairing failure is
# caught and simply skips the extra metadata (it can never fail a package build).
# STABILITY, not proximity, decides: a wide but STABLE open median stays one corridor,
# while a pair whose separation ramps apart is split. There is deliberately no single small
# maximum-distance rule. See docs/adr-divided-highway-corridor-pairing.md.
OFFLINE_SCENE_DIVIDED_PAIRING_ENABLED=true
OFFLINE_SCENE_PAIR_SAMPLE_INTERVAL_M=10
OFFLINE_SCENE_PAIR_WINDOW_M=120
OFFLINE_SCENE_PAIR_MIN_SEPARATION_M=4
OFFLINE_SCENE_PAIR_MAX_SEPARATION_M=120
OFFLINE_SCENE_PAIR_MAX_BEARING_DIFF_DEG=20
OFFLINE_SCENE_PAIR_MAX_OFFSET_ANGLE_DEV_DEG=35
OFFLINE_SCENE_PAIR_SEP_STDEV_MAX_M=12
OFFLINE_SCENE_PAIR_SEP_SLOPE_MAX=0.25
OFFLINE_SCENE_PAIR_MIN_WINDOW_COVERAGE=0.8
OFFLINE_SCENE_PAIR_MIN_CORRIDOR_LENGTH_M=150
OFFLINE_SCENE_PAIR_MIDPOINT_TOLERANCE_M=3

# --- High-definition TILED offline aerial imagery (worker) --------------------
# Imagery is OFF by default (terrain relief only). When an operator enables it, the
# DEFAULT source is USGS/USDA NAIP (public domain) — do NOT claim ArcGIS-map
# equivalence unless you configure the exact licensed imagery service (with export/
# offline-cache rights and separate credentials). Never put a browser ArcGIS API key
# in the worker. "tiled" splits the AOI into JPEG tiles so packaged detail can far
# exceed a single 4000px export without over-requesting beyond source-native GSD.
OFFLINE_SCENE_IMAGERY_ENABLED=false
OFFLINE_SCENE_IMAGERY_MODE=tiled
# "source_native_or_0.6" clamps to the source-native GSD (never finer); or a bare
# float like 0.6 forces that metres/pixel target.
OFFLINE_SCENE_IMAGERY_TARGET_MPP=source_native_or_0.6
OFFLINE_SCENE_IMAGERY_SOURCE_NATIVE_MPP=0.6
OFFLINE_SCENE_IMAGERY_TILE_PX=1024
OFFLINE_SCENE_IMAGERY_TILE_TIMEOUT_S=90
OFFLINE_SCENE_IMAGERY_TILE_RETRIES=3
OFFLINE_SCENE_IMAGERY_OVERALL_DEADLINE_S=1200
OFFLINE_SCENE_IMAGERY_MAX_TILES=64
OFFLINE_SCENE_IMAGERY_MAX_MB=256
OFFLINE_SCENE_IMAGERY_JPEG_QUALITY=85
# Optional licensed imagery service (opt-in). Leave as NAIP unless you have export
# rights for another source. Separate credentials only — never a browser API key.
OFFLINE_SCENE_IMAGERY_EXPORT_URL=https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer

# Bind interfaces (optional)
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
