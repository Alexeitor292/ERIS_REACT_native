# -----------------------------
# Proxmox deployment env file
# Copy to: docker/.env.proxmox
# -----------------------------

TZ=America/Los_Angeles

# Container mode
ENV=prod
LOG_LEVEL=INFO

# MariaDB bootstrap credentials
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
MARIADB_DATABASE=eris
MARIADB_USER=eris_user
MARIADB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# MinIO bootstrap credentials
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=eris-uploads

# External endpoints
# Web app bakes this value into static assets during build.
VITE_API_BASE_URL=http://YOUR_PROXMOX_IP:8000
# Backward-compatible alias used by older bundles
VITE_API_BASE=http://YOUR_PROXMOX_IP:8000

# ArcGIS Maps SDK browser key for the interactive 3D terrain SceneView.
# OPTIONAL: leave blank to use Esri default services (dev). For production set a
# BROWSER-SAFE key restricted (HTTP referrer allow-list) to https://eris.camposlabs.org.
# Build-time only — Vite inlines it into the static web bundle (rebuild the web
# image when it changes). This is the public frontend key; it is NOT and must not
# be the backend ARCGIS_API_KEY (the server runtime key is configured separately
# and is never exposed to the browser).
VITE_ARCGIS_API_KEY=<restricted browser key>

# Backend CORS origins
CORS_ORIGINS=http://YOUR_PROXMOX_IP:5173

# Storage URL mode:
#   presigned (default) — safe for any deployment; returns expiring presigned URLs.
#   public              — for internal-network alpha; returns direct MinIO URLs.
#                         Requires MINIO_PUBLIC_ENDPOINT and client network access to MinIO.
STORAGE_URL_MODE=public

# Client-reachable MinIO API URL.
# For alpha/Proxmox: set to the server IP and MinIO API port (default 9800).
# Web browsers and mobile clients must be able to reach this address directly.
# If MinIO CORS is needed for browser direct GET, allow the web origin in MinIO settings.
MINIO_PUBLIC_ENDPOINT=http://YOUR_PROXMOX_IP:9800

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=120

# Bind interfaces (optional)
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
