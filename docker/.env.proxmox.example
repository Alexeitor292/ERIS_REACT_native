# -----------------------------
# Proxmox deployment env file
# Copy to: docker/.env.proxmox
# -----------------------------

TZ=America/Los_Angeles

# Container mode
ENV=prod
LOG_LEVEL=INFO

# MariaDB bootstrap credentials
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD
MARIADB_DATABASE=eris
MARIADB_USER=eris_user
MARIADB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# MinIO bootstrap credentials
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_BUCKET=eris-uploads

# External endpoints
# Web app bakes this value into static assets during build.
VITE_API_BASE_URL=http://YOUR_PROXMOX_IP:8000
# Backward-compatible alias used by older bundles
VITE_API_BASE=http://YOUR_PROXMOX_IP:8000

# NOTE: VITE_ARCGIS_API_KEY (the browser-safe ArcGIS key for the 3D terrain
# SceneView) is intentionally NOT placed in this file. The backend service loads
# this whole file via `env_file:`, so anything here also lands in the backend
# container's environment. To keep that build-time-only browser key OUT of the
# backend, supply it as a SHELL variable at build time instead (Compose still
# substitutes it into web.build.args). See web/.env.example for the exact
# `export VITE_ARCGIS_API_KEY=... && docker compose ... up -d --build web` flow.

# Backend CORS origins
CORS_ORIGINS=http://YOUR_PROXMOX_IP:5173

# Storage URL mode:
#   presigned (default) — safe for any deployment; returns expiring presigned URLs.
#   public              — for internal-network alpha; returns direct MinIO URLs.
#                         Requires MINIO_PUBLIC_ENDPOINT and client network access to MinIO.
STORAGE_URL_MODE=public

# Client-reachable MinIO API URL.
# For alpha/Proxmox: set to the server IP and MinIO API port (default 9800).
# Web browsers and mobile clients must be able to reach this address directly.
# If MinIO CORS is needed for browser direct GET, allow the web origin in MinIO settings.
MINIO_PUBLIC_ENDPOINT=http://YOUR_PROXMOX_IP:9800

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=120

# Offline 3D scene packages (private bucket + automatic USGS-3DEP generation).
# Bucket is created/verified by the one-shot minio-init service; keep it PRIVATE.
MINIO_OFFLINE_SCENES_BUCKET=eris-offline-scenes
# Production posture: dev mode OFF. When false, MinIO offline-bucket posture
# problems fail closed instead of warning. Only set true for local iteration.
OFFLINE_SCENE_DEV_MODE=false
# One authoritative AOI ceiling (metres), enforced at the API, job creation, and
# the worker. Capped by an absolute hard ceiling so it is never statewide.
OFFLINE_SCENE_MAX_RADIUS_M=3000
# Max registered/downloadable package size (MB) — policy, not device memory.
OFFLINE_SCENE_MAX_PACKAGE_MB=512

# Bind interfaces (optional)
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
