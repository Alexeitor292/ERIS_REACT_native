<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(ERIS_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The ERIS API, from the ERIS_API_BASE_URL build setting. -->
	<key>ERISAPIBaseURL</key>
	<string>$(ERIS_API_BASE_URL)</string>
	<!-- staging or production, from the ERIS_DEPLOYMENT build setting: how the maps are licensed. -->
	<key>ERISDeployment</key>
	<string>$(ERIS_DEPLOYMENT)</string>
	<!-- MSAL: Microsoft Authenticator returns to msauth.<bundle id>://auth. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>msauthv2</string>
		<string>msauthv3</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>ERIS takes field photos for incident reports and assessment forms, recording where and which way each was taken.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ERIS uses your location to fill in an incident's district, county, route and post mile, and to map where each field photo was taken.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ERIS attaches the photos you choose to incident reports and assessment forms.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>gov.ca.dot.eris.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
