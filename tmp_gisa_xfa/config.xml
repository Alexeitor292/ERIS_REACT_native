<config xmlns="http://www.xfa.org/schema/xci/1.0/" xmlns:xfa="http://www.xfa.org/schema/xci/1.0/">
      <present> <!--  [0..n]  -->
         <common>
            <data>
               <adjustData>1</adjustData> <!-- 0|1 -->
               <attributes>preserve</attributes> <!-- ignore|delegate|preserve -->
               <outputXSL>
                  <uri/>
               </outputXSL>
               <range/>
               <record/>
               <startNode/>
               <uri/>
               <window/>
               <xsl>
                  <debug>
                     <uri/>
                  </debug>
                  <uri/>
               </xsl>
            </data>
            <log> <!--  [0..n]  -->
               <uri/>
               <mode>append</mode> <!-- append|overwrite -->
               <threshold>trace</threshold> <!-- trace|information|warning|error -->
               <to>memory</to> <!-- uri|memory|stdout|null|stderror|system -->
            </log>
            <temp>
               <uri>C:\Adobe\temp</uri>
            </temp>
            <template>
               <base/>
               <startPage>0</startPage>
               <uri/>
               <relevant/>
            </template>
            <locale>en_US</locale>
         </common>
         <copies>1</copies>
         <destination>pdf</destination> <!-- pdf|ps|pcl -->
         <driver> <!--  [0..n]  -->
            <fontInfo>
               <embed>0</embed> <!-- 0|1 -->
               <map>
                  <equate/> <!-- [0..n] Attributes: from='', to='' [0..n]  -->
               </map>
               <subsetBelow>100</subsetBelow>
            </fontInfo>
            <xdc>
               <uri/>
            </xdc>
         </driver>
         <pdf> <!--  [0..n]  -->
         	<!-- Temporarily turned off until PDFUpdate is able to append with compression. -->
            <compression>
	       <compressLogicalStructure>1</compressLogicalStructure> <!-- 0|1 -->
               <level>1</level> <!-- 0 - 9, 0=no compression 1=best speed 9=best compression -->
               <type>none</type>
            </compression>
            <encryption>
               <encrypt>0</encrypt> <!-- 0|1 -->
               <encryptionLevel>40bit</encryptionLevel> <!-- 40bit|128bit -->
               <masterPassword/>
               <permissions>
                  <accessibleContent>0</accessibleContent> <!-- 0|1 -->
                  <contentCopy>0</contentCopy> <!-- 0|1 -->
                  <documentAssembly>0</documentAssembly> <!-- 0|1 -->
                  <formFieldFilling>0</formFieldFilling> <!-- 0|1 -->
                  <modifyAnnots/>
                  <plaintextMetadata>0</plaintextMetadata> <!-- 0|1 -->
                  <print>1</print> <!-- 0|1 -->
                  <printHighQuality/>
                  <change>0</change> <!-- 0|1 -->
               </permissions>
               <userPassword/>
            </encryption>
            <fontInfo>
               <embed>0</embed> <!-- 0|1 -->
               <!--defaultTypeface>MyriadPro-Regular</defaultTypeface-->

               <map>
                  <!-- [0..n] Attributes: from='', to='' [0..n]  -->
 					<equate force="0" from="Courier_*_*" to="Courier New_*_*"/>
					<equate force="0" from="CourierNew_*_*" to="Courier New_*_*"/>
					<equate force="0" from="Courier-New_*_*" to="Courier New_*_*"/>
					<equate force="0" from="MyriadPro_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="MyriadPro-Regular_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="MyriadPro-It_*_*" to="Myriad Pro_*_italic"/>
					<equate force="0" from="MyriadPro-SemiboldSemiCn_*_*" to="Arial Narrow_bold_*"/>
					<equate force="0" from="MyriadPro-SemiboldCond_*_*" to="Arial Narrow_bold_*"/>
					<equate force="0" from="MinionPro_*_*" to="Minion Pro_*_*"/>
					<equate force="0" from="MinionPro-Regular_*_*" to="Minion Pro_*_*"/>
					<equate force="0" from="ArialNarrow_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="Arial-Narrow_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="ArialMT_*_*" to="Arial_*_*"/>
					<equate force="0" from="DTLDocumentaSansT_bold_*" to="Arial Narrow_bold_*"/>
					<equate force="0" from="DTLDocumentaSansST_bold_*" to="Arial Narrow_bold_*"/>
					<equate force="0" from="Helvetica Black_*_*" to="Myriad Pro Black_*_*"/>
					<equate force="0" from="HelveticaBlack_*_*" to="Myriad Pro Black_*_*"/>
					<equate force="0" from="Helvetica-Black_*_*" to="Myriad Pro Black_*_*"/>
					<equate force="0" from="Helvetica-Condensed-Black_*_*" to="Arial Narrow_bold_*"/>
					<equate force="0" from="Helvetica-Condensed_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="HelveticaNeue-Roman_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="HelveticaNeue-Light_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="HelveticaNeue_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="Helvetica_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="Helv_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="Cour_*_*" to="Courier New_*_*"/>
					<equate force="0" from="Times_*_*" to="Times New Roman_*_*"/>
					<equate force="0" from="Times-Roman_*_*" to="Times New Roman_*_*"/>
					<equate force="0" from="TimesNewRoman_*_*" to="Times New Roman_*_*"/>
					<equate force="0" from="GillSans_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="HelvOut Blk" to="Myriad Pro"/>
					<equate force="0" from="PDP Helv_*_*" to="Myriad Pro_*_*"/>
					<equate force="0" from="CG Times_*_*" to="Minion Pro_*_*"/>
					<equate force="0" from="ZapfDingbats_*_*" to="WingDings_*_*"/>
					<equate force="0" from="FranklinGothic-Demi_*_*" to="Myriad Pro_bold_*"/>
					<equate force="0" from="FormataCondensed-Light_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="FormataCondensed-Regular_*_*" to="Arial Narrow_*_*"/>
					<equate force="0" from="FormataCondensed-Medium_*_*" to="Arial Narrow_bold_*"/>
<!--					
					<equate from='MS-PGothic_*_*' to='MS PGothic_*_*' force="0"/>
					<equate from='MS-PGothic+1_*_*' to='MS PGothic_*_*' force="0"/>
					<equate from='MS-PGothic+2_*_*' to='MS PGothic_*_*' force="0"/>
					<equate from='MS-PGothic+3_*_*' to='MS PGothic_*_*' force="0"/>
					<equate from='MS-PGothic+4_*_*' to='MS PGothic_*_*' force="0"/>
-->			
					<equate force="0" from="HGPSoeiKakugothicUB_*_*" to="MS Gothic_*_*"/>
					<equate force="0" from="GothicBBB-Medium-Identity-H_*_*" to="MS Gothic_*_*"/>
               </map>
               <subsetBelow>100</subsetBelow> <!-- An integer value between 0-100 representing a percentage -->
            </fontInfo>
            <interactive>1</interactive> <!-- 0|1 -->
            <openAction>
               <destination>none</destination> <!-- none|pageFit -->
            </openAction>
            <creator>Adobe LiveCycle Forms ES4</creator>
            <producer>Adobe LiveCycle Forms ES4</producer>
            <scriptModel>XFA</scriptModel> <!-- XFA|none -->
            <submitFormat>pdf</submitFormat> <!-- html|fdf|xml|pdf -->
            <tagged>1</tagged> <!-- 0|1 -->
            <xdc>
               <uri/>
            </xdc>
            <version>1.7</version> <!-- 1.2=acrobat 3|1.3=acrobat 4 -->
            <renderPolicy>client</renderPolicy>
         <adobeExtensionLevel>3</adobeExtensionLevel></pdf>
         
         <zpl>
			<fontInfo>
				<defaultTypeface writingScript="Roman">CG Triumvirate</defaultTypeface>
				<defaultTypeface writingScript="Japanese">Kozuka Mincho Pro-VI R</defaultTypeface>
				<defaultTypeface writingScript="SimplifiedChinese">Adobe Song Std L</defaultTypeface>
				<defaultTypeface writingScript="TraditionalChinese">Adobe Ming Std L</defaultTypeface>
				<defaultTypeface writingScript="Korean">Adobe Myungjo Std M</defaultTypeface>
				<map>
					<equate force="1" from="MS Gothic_*_*" to="Kozuka Gothic Pro M_*_*"/>
				</map>
			</fontInfo>
		</zpl>

         
         <webClient> <!--  [0..n]  -->
            <fontInfo>
               <embed>0</embed> <!-- 0|1 -->
               <map>
                  <equate/> <!-- [0..n] Attributes: from='', to='' [0..n]  -->
               </map>
               <subsetBelow>100</subsetBelow>
            </fontInfo>
            <xdc>
               <uri/>
            </xdc>
         </webClient>
         <xdp> <!--  [0..n]  -->
            <embedRenderedOutput>1</embedRenderedOutput> <!-- 0|1 -->
            <packets>*</packets>
         </xdp>
         <layout>paginate</layout> <!-- paginate|panel -->
         <output>
            <uri/>
            <to>memory</to> <!-- uri|memory|stdout|null -->
            <type>native</type> <!-- native|xdp|mergedXDP -->
         </output>
         <script>
            <currentPage/>
            <exclude>nullTest formatTest</exclude>
            <runScripts>both</runScripts> <!-- client|server|both -->
         </script>
     <submitUrl>http://localhost:80/v2Forms/Flatform</submitUrl></present>
     <acrobat>
         <acrobat7>
             <dynamicRender>required</dynamicRender>
         </acrobat7>
     <common>
            <data>
               <adjustData>1</adjustData> <!-- 0|1 -->
               <attributes>preserve</attributes> <!-- ignore|delegate|preserve -->
               <outputXSL>
                  <uri/>
               </outputXSL>
               <range/>
               <record/>
               <startNode/>
               <uri/>
               <window/>
               <xsl>
                  <debug>
                     <uri/>
                  </debug>
                  <uri/>
               </xsl>
            </data>
            <log> <!--  [0..n]  -->
               <uri/>
               <mode>append</mode> <!-- append|overwrite -->
               <threshold>trace</threshold> <!-- trace|information|warning|error -->
               <to>memory</to> <!-- uri|memory|stdout|null|stderror|system -->
            </log>
            <temp>
               <uri>C:\Adobe\temp</uri>
            </temp>
            <template>
               <base/>
               <startPage>0</startPage>
               <uri/>
               <relevant/>
            </template>
            <locale>en_US</locale>
         </common></acrobat>
   </config>